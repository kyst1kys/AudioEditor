<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="480.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nievierov.client.controller.TrackController">

    <VBox spacing="10.0"
          AnchorPane.topAnchor="15.0"
          AnchorPane.leftAnchor="15.0"
          AnchorPane.rightAnchor="15.0">

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" />
                <ColumnConstraints minWidth="350.0" />
            </columnConstraints>

            <Label text="Project UUID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="projectIdField" promptText="UUID проєкту" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Button text="Створити доріжку (POST)" onAction="#handleCreateTrack" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <Separator prefWidth="200.0" />

        <Button text="Отримати доріжки проєкту (GET)" onAction="#handleGetTracks"/>

        <TextArea fx:id="tracksArea" editable="false" prefHeight="200.0" prefWidth="570.0"/>
    </VBox>

</AnchorPane>